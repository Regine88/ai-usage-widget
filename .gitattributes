# Normalize every text file to LF so edits on Windows stop producing whole-file churn.
* text=auto eol=lf

*.ps1   text eol=lf
*.psm1  text eol=lf
*.psd1  text eol=lf
*.ps1xml text eol=lf
*.vbs   text eol=lf
*.cmd   text eol=lf
*.bat   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf

# Binary assets must never be line-ending converted.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.pdf  binary
*.exe  binary

*.log           -text
ai-state.json   -text
