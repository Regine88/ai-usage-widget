root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.ps1]
# Windows PowerShell 5.1 misreads non-BOM UTF-8 files that contain non-ASCII text.
charset = utf-8-bom

[*.{md,yml,yaml,json,jsonl}]
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.vbs]
indent_size = 4

[LICENSE]
indent_style = off
indent_size = off
insert_final_newline = true
